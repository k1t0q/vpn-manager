[Unit]
Description=CAESAR VPN HOSTKEY mobile push reminders
After=network-online.target caesar-vless-panel.service
Wants=network-online.target

[Service]
Type=oneshot
User=caesar-manager
Group=caesar-manager
WorkingDirectory=/srv/caesar-manager-src
ExecStart=/opt/caesar-push-venv/bin/python /srv/caesar-manager-src/server/hostkey_push.py deliver
UMask=0077
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ReadWritePaths=/var/lib/caesar-manager
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

